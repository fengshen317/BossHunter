# 复制为 .env，填写 LangSmith API Key 后重启后端。
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=lsv2_pt_your_key_here
LANGSMITH_PROJECT=BossHunter

# Web 管理面鉴权：仅当通过 BOSSHUNTER_HOST 绑定到非回环地址（局域网/公网）时需要。
# 设置后所有 /api/* 请求必须携带 Header: Authorization: Bearer <token>。
# 默认回环地址（127.0.0.1）无需设置，保持本地零配置。
# BOSSHUNTER_AUTH_TOKEN=your_secret_token

