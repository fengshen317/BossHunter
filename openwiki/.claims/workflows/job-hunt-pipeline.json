    {
      "id": "claim_51ad6ca9ac9841cab6201f8e9a6042ab",
      "statement": "run_pipeline in src/bosshunter/pipeline.py is the top-level orchestrator: it checks the Browser Runtime and BOSS tab first, then drives scrape → score (which generates greetings) → confirm → send, and finally loops monitor_and_send_resumes every monitor.interval minutes until interrupted, preserving the fixed stage order.",
      "evidence": [
        {
