    {
      "id": "claim_5e56afbd6b8f4ace80f96d088b2b831b",
      "statement": "AssistantService.send_message is the single Web-API entrypoint into the assistant graph: it persists the user message, creates a run, acquires the per-conversation coordinator lock with a 5-second timeout, and raises RuntimeError when the lock is not acquired so concurrent same-conversation messages cannot interleave.",
      "evidence": [
        {
          "resource": "repo://src/bosshunter/assistant/service.py#L108-L150",
          "version": "repo-lines-v1:sha256:3853712850d2fd3dc1010f7ceacc45d05b0c886ccc83a247baf4a2c6d733a28e:"
        }
      ]
    },
    {
