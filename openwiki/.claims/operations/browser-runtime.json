    },
    {
      "id": "claim_2f2da6678f5d4741b33d3f595cff1449",
      "statement": "ensure_runtime() auto-starts the bundled Node proxy only when browser.runtime is 'builtin', auto_start_proxy is enabled, and Node.js is available; the spawn-and-poll window is serialized under _runtime_lock to prevent concurrent callers from spawning orphan proxies, and readiness is proven by runtime_targets() returning a list before the wait deadline.",
      "evidence": [
        {
          "resource": "repo://src/bosshunter/browser/runtime/__init__.py#L179-L208",
          "version": "repo-lines-v1:sha256:6c3b5bd2a2423013393811d5d215e7f561b05b14fae20b858cea0b3898ec5815:"
        },
        {
