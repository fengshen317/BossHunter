    {
      "id": "claim_8edbda8f662a424a9a1dabc8a21e926d",
      "statement": "When the port guard is enabled, the proxy runs Fetch.enable on each newly attached session with request-stage patterns for http://127.0.0.1:{chromePort}/* and http://localhost:{chromePort}/*, and answers Fetch.requestPaused with Fetch.failRequest using errorReason ConnectionRefused to block pages from probing Chrome's debug port.",
      "evidence": [
        {
          "resource": "repo://src/bosshunter/browser/runtime/cdp-proxy.mjs#L169-L176",
          "version": "repo-lines-v1:sha256:57a6c72f5fac6749982f0ca39123e68b7cc15ff6afbf68b5cd6f27301d167868:"
