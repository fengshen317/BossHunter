    {
      "id": "claim_93b0820614f341caaf84762886fa2f58",
      "statement": "The proxy discovers Chrome by reading platform-specific DevToolsActivePort files and then probing BOSSHUNTER_CHROME_PORTS, validating candidates through GET /json/version and its webSocketDebuggerUrl; discovery results are cached and cleared on connection error or close so a closed Chrome triggers re-discovery.",
      "evidence": [
        {
          "resource": "repo://src/bosshunter/browser/runtime/cdp-proxy.mjs#L119-L163",
          "version": "repo-lines-v1:sha256:b523fce4b9611eee501c98feea9c62978e849435fc8084626498b2fc8e9f92ac:"
