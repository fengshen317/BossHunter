    {
      "id": "claim_8f498a2bbaf542c9af5d3ebd8d30416c",
      "statement": "cdp-proxy.mjs exposes a local HTTP API (/health, /targets, /new, /close, /navigate, /back, /eval, /click, /clickAt, /type, /setFiles, /scroll, /screenshot, /pdf, /info) and implements each non-health endpoint by attaching a CDP session to the target and translating the HTTP request into CDP commands, returning JSON or 4xx/5xx error bodies.",
