          "version": "repo-lines-v1:sha256:ed49a5da0346a53643bed38116001e52d2e341db9c19e98b677a35ba461a5e5e:"
        }
      ]
    },
    {
      "id": "claim_f7b844d352e348a989b234a3f7d9ccfb",
      "statement": "When /health answers but does not identify as 'bosshunter', ensure_runtime() switches to the next available proxy port within proxy_port+1 .. +100, updates both the passed config and the process-wide _browser_config, and get_runtime_url() derives the base URL from the updated proxy_host and proxy_port.",
      "evidence": [
        {
          "resource": "repo://src/bosshunter/browser/runtime/__init__.py#L122-L149",
          "version": "repo-lines-v1:sha256:da0973dd2b9c12e03345ea579ddd51792dfa3ed1b0af3cc6ec84ffe8e071e6b8:"
