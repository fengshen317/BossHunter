    {
      "id": "claim_dc0bd573cd754b6a8a753e19255d2445",
      "statement": "start_runtime() launches the proxy detached and passes BOSSHUNTER_BROWSER_PROXY_PORT, BOSSHUNTER_CHROME_PORTS, and BOSSHUNTER_ENABLE_PORT_GUARD as environment variables that configure the proxy's HTTP port, candidate Chrome debug ports, and port-guard switch.",
