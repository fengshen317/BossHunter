    {
      "id": "claim_1fb3105f06ff43e79c11ca9934aea424",
      "statement": "launcher.py discovers Chrome or Edge by checking browser.executable_path first, then PATH command names, then platform install paths, and builds a command with --remote-debugging-port, an isolated --user-data-dir (default ./data/browser-profile), --no-first-run, --no-default-browser-check, and the local dashboard URL so login state is isolated and no zhipin.com URL is opened directly.",
