    },
    {
      "id": "claim_4456d78df19b40f1a44182495f0c1fe0",
      "statement": "All base URLs come from environment (`OPENAI_BASE_URL` / `ANTHROPIC_BASE_URL`) or `ai.base_url`; no compatible-service domain is hardcoded in the dispatch code, and model defaults such as `claude-sonnet-4-6` and `deepseek-chat` are identifiers rather than endpoints.",
      "evidence": [
        {
          "resource": "repo://src/bosshunter/ai/credentials.py#L139-L141",
