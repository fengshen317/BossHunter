    },
    {
      "id": "claim_d65032c862614fc99ed331eb65fa2719",
      "statement": "OpenAI-compatible HTTP calls retry `429` and `500/502/503/504` plus `httpx` transport and timeout errors with exponential backoff and jitter, clamped to `http_max_retries` in [0,5] (default 3); non-retryable statuses such as `404`, `401`, and `403` are re-raised immediately.",
      "evidence": [
        {
          "resource": "repo://src/bosshunter/ai/credentials.py#L41-L113",
          "version": "repo-lines-v1:sha256:4b3e20c3ad8c9c48b6b48bf37300bf6fefb112bbfbb92836129e0f7769ea4d12:"
        }
      ]
    },
    {
      "id": "claim_e3845e17ff734f218cccad227fcb3016",
      "statement": "The Anthropic Messages path always sends `max_tokens` (default 8192) because the API requires it, while the OpenAI-compatible chat-completions path intentionally omits `max_tokens` and `max_completion_tokens` so provider defaults apply.",
