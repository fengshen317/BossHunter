  "claims": [
    {
      "id": "claim_4a977dc7b6d74d94988ca843598481ef",
      "statement": "The AI layer supports exactly two providers, `anthropic` and `openai_compatible`; `load_config` fails fast with `ValueError` for any other `ai.provider`, and the shared helpers dispatch `anthropic` to the Anthropic SDK Messages API and `openai_compatible` to an `httpx` chat-completions call.",
      "evidence": [
        {
          "resource": "repo://src/bosshunter/ai/credentials.py#L210-L236",
          "version": "repo-lines-v1:sha256:143c01a91dbbe9790df2a7f851da0b291045167224b84a51ca95946248a24aea:"
        },
        {
          "resource": "repo://src/bosshunter/ai/credentials.py#L421-L461",
          "version": "repo-lines-v1:sha256:8cc7504fa3253ec2445099db8f440bda118026e972683c215eb17c511e063873:"
        },
        {
          "resource": "repo://src/bosshunter/config.py#L161-L165",
          "version": "repo-lines-v1:sha256:32a0bd384790549d212e4606312ebb9cdc51a48cdea4dae34901e59c7c098aaa:"
        },
        {
          "resource": "repo://src/bosshunter/config.py#L34-L34",
          "version": "repo-lines-v1:sha256:8712e8291445b5d15aae25df9f3ac05cf9aed5a451db2bd2d72ba0efa85e9ed4:"
        }
      ]
    },
    {
      "id": "claim_af233a7492ab4ff0985e22ed1dc63f2a",
      "statement": "Credential resolution is environment-first: `get_anthropic_api_key` resolves `ANTHROPIC_API_KEY` then `ANTHROPIC_AUTH_TOKEN` then `ai.api_key` then `ai.auth_token`, while the OpenAI-compatible helpers resolve `OPENAI_API_KEY` then `ANTHROPIC_API_KEY` then `ai.api_key`.",
      "evidence": [
        {
          "resource": "repo://src/bosshunter/ai/credentials.py#L116-L124",
          "version": "repo-lines-v1:sha256:8a57f341f75942302edce8a495cfa7251e873133e04c770f3f92ef53d206818a:"
        },
        {
          "resource": "repo://src/bosshunter/ai/credentials.py#L254-L255",
          "version": "repo-lines-v1:sha256:f1b6ed4d5a27096441094d3dcc2b6f7fc3c81e21e617ca86c22f8ba0871078d8:"
