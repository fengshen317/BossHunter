    {
      "id": "claim_4fab1893433a4dacb2eb9f854fba3ec8",
      "statement": "Request timeout defaults to 180 seconds, clamps to [10, 600], and falls back to the default on invalid values; `_anthropic_client` always injects the timeout and a retry cap into the Anthropic SDK client, while `build_anthropic_client_kwargs` only injects timeout when `ai.request_timeout` is explicitly set.",
      "evidence": [
        {
          "resource": "repo://src/bosshunter/ai/credentials.py#L143-L148",
          "version": "repo-lines-v1:sha256:fd2d25b1855a43211a684b4d848be054ab199d109ae384751d0886bcb399e0fc:"
