    {
      "id": "claim_17bbbb565b4c48ef87a0f87b0362ec01",
      "statement": "When an Anthropic `base_url` is configured, `resolve_anthropic_model` probes `GET /v1/models`, fuzzy-matches the configured model against returned IDs, and caches only successful resolutions under a key containing a SHA-256 fingerprint of the credential rather than the raw secret, guarded by a lock against concurrent probe stampedes.",
      "evidence": [
        {
          "resource": "repo://src/bosshunter/ai/credentials.py#L151-L190",
          "version": "repo-lines-v1:sha256:b0a4d4236cfca39bed00deaf0e135389c3a48b2f823c282d8fa65709eb9c5ffd:"
