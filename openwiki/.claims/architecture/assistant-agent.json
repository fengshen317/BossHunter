    {
      "id": "claim_4c088da1617743e792c5e0261ba51c92",
      "statement": "build_assistant_graph() registers a controlled LangGraph node graph: the fixed pipeline context_resolver → goal_extractor → ambiguity_checker, conditional routing into clarification/sql_prepare/direct/capability/planner, planner→plan_evaluator↔replanner, capability_matcher→dag_executor/react_agent/execution_engine, a react_agent↔react_tool loop, execution_engine→approval/result_processor, and approval→execution_engine/result_processor.",
      "evidence": [
        {
          "resource": "repo://src/bosshunter/assistant/graph.py#L1959-L2024",
          "version": "repo-lines-v1:sha256:747682e4c5fe977cbd268fa76755c787c058c686ed8fc644f5a08b981e0fa074:"
        }
      ]
    },
    {
