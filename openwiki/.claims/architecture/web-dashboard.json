    {
      "id": "claim_7fb68072bc9c4f1eb9992c044db81d07",
      "statement": "run_server defaults to 127.0.0.1:8686, refuses to bind a non-loopback host without BOSSHUNTER_AUTH_TOKEN, and serves through ThreadedWSGIRefServer (wsgiref plus ThreadingMixIn) so per-request threads keep long-lived SSE streams from blocking the other endpoints.",
      "evidence": [
