    {
      "id": "claim_e4cf30d376b84af09289837551449acb",
      "statement": "The workbench task executors are registered once on the module-level WorkbenchTaskRunner at import time, mapping full, collect, score, reenrich, monitor, deliver, greeting, reply, and import modes to their _execute_* adapters.",
