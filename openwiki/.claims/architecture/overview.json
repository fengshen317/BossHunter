    {
      "id": "claim_90759aedee56486f83be1d1fbb52eae4",
      "statement": "BossHunter v2.0 implements a fixed end-to-end job-hunt loop — scrape, rule prefilter, AI deep score, greeting generation, mandatory human confirmation, low-frequency send, and reply monitoring — and the CLI, web dashboard, and assistant all converge on these same owned domain services.",
      "evidence": [
        {
          "resource": "repo://AGENTS.md#L10-L21",
          "version": "repo-lines-v1:sha256:1573544552b2e294e7f84c3a9d286775df16b917c2e52e0ddac594d5a4c94062:"
