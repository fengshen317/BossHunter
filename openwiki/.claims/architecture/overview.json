    {
      "id": "claim_5b2350e54c14404ba9f0a4c460946fbf",
      "statement": "The data model consists of `jobs`, `history`, `job_events`, `risk_events`, and `workbench_tasks`, with database triggers writing status-change events and semantic views exposing current-job and funnel facts.",
