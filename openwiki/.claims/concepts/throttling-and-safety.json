      "id": "claim_9e58b6c6015548a6b4eda93e487f8d5a",
      "statement": "RequestThrottle spaces out sends with a Gaussian-distributed delay derived from delay_min and delay_max, injects a 5% chance of an extra 2-5 second human-hesitation pause, and adds a burst penalty when 3+ requests land within 15 seconds or 6+ within 45 seconds; mark() records each completed send for those burst calculations.",
      "evidence": [
        {
          "resource": "repo://src/bosshunter/throttle.py#L10-L56",
          "version": "repo-lines-v1:sha256:a4aed57f3115ef901533ce07076f6cb274401a271862ec5172bd426edfef37f5:"
        }
      ]
    },
